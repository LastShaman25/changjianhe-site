# Canonical production URL (used by metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://changjianhe.com

# Optional: set all three in Vercel to enable the email contact form.
# Without them the site displays the LinkedIn contact option.
# Keep these server-only; never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
